13:["$","article",null,{"children":[["$","header",null,{"className":"border-b border-line","children":["$","div",null,{"className":"mx-auto max-w-content px-6 pb-14 pt-16 md:px-10 md:pt-20","children":[["$","$L1b",null,{"href":"/#work","data-cursor":"link","className":"inline-flex items-center gap-1.5 text-[13px] text-muted hover:text-ink","children":[["$","span",null,{"aria-hidden":"true","children":"←"}]," All work"]}],["$","div",null,{"className":"mt-8 flex flex-wrap items-center gap-2","children":[[["$","span","AI / ML",{"className":"rounded-full border border-line px-2.5 py-1 text-[11.5px] text-muted","children":"AI / ML"}],["$","span","Backend / Systems",{"className":"rounded-full border border-line px-2.5 py-1 text-[11.5px] text-muted","children":"Backend / Systems"}],["$","span","Client Work",{"className":"rounded-full border border-line px-2.5 py-1 text-[11.5px] text-muted","children":"Client Work"}]],["$","span",null,{"className":"rounded-full border border-signal/40 bg-signal/10 px-2.5 py-1 text-[11.5px] text-signal","children":"In Production"}]]}],["$","h1",null,{"className":"mt-5 max-w-3xl font-display text-3xl leading-tight text-ink text-balance md:text-5xl","children":"Offline-First Clinical Decision Support Platform"}],["$","p",null,{"className":"mt-5 max-w-2xl text-[16px] leading-relaxed text-muted","children":"A multi-agent AI system that gives rural health workers real-time clinical guidance with no internet connection."}],["$","div",null,{"className":"mt-8 flex flex-wrap gap-x-8 gap-y-2 text-[13.5px] text-faint","children":[["$","span",null,{"children":"Agentic Systems Backend Engineer"}],["$","span",null,{"children":"HabTech Solution — Ethiopia Health Extension Program"}],["$","span",null,{"children":"Feb 2026 – Aug 2026"}]]}]]}]}],["$","div",null,{"className":"mx-auto max-w-content px-6 py-16 md:px-10 md:py-20","children":["$","div",null,{"className":"grid gap-16 md:grid-cols-[1.5fr_1fr]","children":[["$","div",null,{"className":"space-y-14","children":[["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Overview"}],["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted","children":"A national-scale platform that lets health workers in low-connectivity regions get AI-assisted clinical guidance, while giving federal and regional stakeholders a live view of immunization and maternal-health indicators."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Problem"}],["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted","children":"Ethiopia's Health Extension Program relies on thousands of rural workers who often operate with no reliable internet access. Existing decision-support tools assumed connectivity, leaving frontline workers without guidance exactly when it mattered — and left policymakers unable to see what was happening on the ground in anything close to real time."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Solution"}],["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted","children":"I architected an offline-first platform where the client keeps working without a network, and a multi-agent backend intelligently routes each worker's question to the right specialised agent — consultation, simulation, or analysis — rather than sending every request through a single expensive model call. Every AI-generated recommendation is checked against a deterministic rules layer for things like vaccine schedules, dosage, and danger-sign detection before it ever reaches a worker, and outputs are grounded in approved national medical guidelines rather than open-ended generation."}]]}],["$","section",null,{"children":["$L1c","$L1d"]}],"$L1e","$L1f","$L20"]}],"$L21"]}]}]]}]
22:I[25861,["/_next/static/chunks/3fntmmi971322.js","/_next/static/chunks/31s3m329ugej9.js","/_next/static/chunks/0m2a3216aop5r.js"],"default"]
1c:["$","h2",null,{"className":"font-display text-xl text-ink","children":"My role"}]
1d:["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted","children":"I designed the multi-agent routing system, the guideline-grounding layer that anchors model outputs to approved clinical protocols, the safety-validation rules engine, and the fault-tolerant sync architecture that lets field devices operate through intermittent connectivity without losing data. I also built the aggregation pipeline and natural-language analytics interface that non-technical policymakers use to query health data directly."}]
1e:["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Engineering challenges"}],["$","div",null,{"className":"mt-6 space-y-7","children":[["$","div","Trustworthy AI under clinical stakes",{"className":"border-l-2 border-line pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Trustworthy AI under clinical stakes"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"A hallucinated recommendation in this context isn't a bad UX moment, it's a patient-safety risk. I addressed this by treating the LLM as one input to a decision, not the decision-maker: outputs are grounded against approved guidelines and then re-checked by deterministic rules before anything reaches a health worker. That combination is what got unsafe recommendations down to roughly 2%, rather than trying to solve safety with prompting alone."}]]]}],["$","div","Designing for intermittent, not absent, connectivity",{"className":"border-l-2 border-line pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Designing for intermittent, not absent, connectivity"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"The hard case isn't 'always offline' or 'always online' — it's a device that drops and regains connectivity unpredictably mid-session. I built fault-tolerant sync workflows around this reality specifically, which is what took data-loss risk down by roughly 90% instead of just handling the easy fully-offline case."}]]]}],["$","div","Keeping routing cheap at national scale",{"className":"border-l-2 border-line pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Keeping routing cheap at national scale"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"Sending every query to a full model call doesn't scale to thousands of concurrent field devices. The multi-agent router classifies intent first and only invokes the specialised agent actually needed, which is what reduced both query resolution time and unnecessary model usage together, rather than trading one for the other."}]]]}]]}]]}]
1f:["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Technical decisions"}],["$","div",null,{"className":"mt-6 space-y-7","children":[["$","div","A rules layer instead of relying on the model alone",{"className":"border-l-2 border-signal/40 pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"A rules layer instead of relying on the model alone"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"For dosage and danger-sign logic specifically, deterministic rules are auditable and testable in a way a model's reasoning isn't. I kept the LLM responsible for language and triage, and kept anything with a hard clinical threshold in explicit, versioned rules."}]]]}],["$","div","Multiple narrow agents instead of one general agent",{"className":"border-l-2 border-signal/40 pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Multiple narrow agents instead of one general agent"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"A single general-purpose agent would have made every query pay the cost — and the risk profile — of the hardest query type. Splitting consultation, simulation, and analysis into separate agents with a lightweight router in front kept each agent's scope, and its failure modes, easier to reason about."}]]]}]]}]]}]
20:["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Results"}],["$","ul",null,{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"~5,000 rural health workers now get clinical guidance with response latency under 5 seconds even without connectivity."]}],["$","li","1",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"~98% of unsafe recommendations are caught before reaching a health worker."]}],["$","li","2",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"~90% reduction in data-loss risk across intermittent-connectivity field deployments."]}],["$","li","3",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"~35% reduction in query resolution time via intelligent agent routing."]}],["$","li","4",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"Regional and federal stakeholders can now query immunization and maternal-health data in natural language and get a visualisation back in seconds."]}]]}]]}]
