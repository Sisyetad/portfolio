4:["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"AI-powered content generation is inherently slow and variable in latency. Routing that work through Celery/Redis background workers, with WebSockets pushing the result back once ready, kept the API responsive regardless of how long a given workflow takes."}]
5:["$","div","Modularity under a real delivery timeline",{"className":"border-l-2 border-line pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Modularity under a real delivery timeline"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"Client work has to stay maintainable past handoff. Keeping the architecture clean and modular — clear boundaries between the API, the async layer, and the AI workflow layer — was a deliberate choice to keep the system extensible after delivery, not just to ship the first version."}]]]}]
6:["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Technical decisions"}],["$","div",null,{"className":"mt-6 space-y-7","children":[["$","div","Celery + Redis for the AI workflow queue",{"className":"border-l-2 border-signal/40 pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Celery + Redis for the AI workflow queue"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"AI content workflows don't fit a synchronous request/response model. A dedicated async queue let the API stay fast while the actual generation work happens in the background."}]]]}]]}]]}]
7:["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Results"}],["$","ul",null,{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"Shipped to production and in ongoing live deployment."]}],["$","li","1",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"[Add measurable results if available]"]}]]}]]}]
8:["$","aside",null,{"className":"space-y-10 md:sticky md:top-24 md:self-start","children":[["$","$L16",null,{"layers":[{"label":"Client (Next.js)","detail":"The user-facing surface, served from the same deployment as the API."},{"label":"API layer (FastAPI)","detail":"Scalable REST endpoints fronting the application logic."},{"label":"Async workers (Celery + Redis)","detail":"Background processing so long-running work never blocks a request."},{"label":"AI content workflows (LangGraph)","detail":"Orchestrates the AI-powered content generation/processing steps."},{"label":"Real-time layer (WebSockets)","detail":"Pushes live updates to connected clients as background work completes."},{"label":"Data layer (PostgreSQL + Redis)","detail":"Persistent storage plus a fast cache/queue backing the async layer."},{"label":"Dockerized deployment","detail":"Reproducible builds shipped as containers."}]}],["$","div",null,{"children":[["$","p",null,{"className":"mb-3 text-[12px] text-faint","children":"Stack"}],["$","div",null,{"className":"flex flex-wrap gap-2","children":[["$","span","Next.js",{"className":"inline-flex items-center gap-1.5 rounded-md border border-line px-2.5 py-1 text-[12px] text-muted","children":[["$","svg",null,{"stroke":"currentColor","fill":"currentColor","strokeWidth":"0","role":"img","viewBox":"0 0 24 24","className":"h-3.5 w-3.5 shrink-0","aria-hidden":"true","children":["$undefined",[["$","path","0",{"d":"M18.665 21.978C16.758 23.255 14.465 24 12 24 5.377 24 0 18.623 0 12S5.377 0 12 0s12 5.377 12 12c0 3.583-1.574 6.801-4.067 9.001L9.219 7.2H7.2v9.596h1.615V9.251l9.85 12.727Zm-3.332-8.533 1.6 2.061V7.2h-1.6v6.245Z","children":[]}]]],"style":{},"height":"1em","width":"1em","xmlns":"http://www.w3.org/2000/svg"}],"Next.js"]}],["$","span","FastAPI",{"className":"inline-flex items-center gap-1.5 rounded-md border border-line px-2.5 py-1 text-[12px] text-muted","children":[["$","svg",null,{"stroke":"currentColor","fill":"currentColor","strokeWidth":"0","rol