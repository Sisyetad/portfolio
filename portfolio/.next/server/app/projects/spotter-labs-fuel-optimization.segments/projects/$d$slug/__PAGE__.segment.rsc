0:{"buildId":"Yfz4KpwW7jcYfcSEaFpzU","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","header",null,{"className":"border-b border-line","children":["$","div",null,{"className":"mx-auto max-w-content px-6 pb-14 pt-16 md:px-10 md:pt-20","children":[["$","$L2",null,{"href":"/#work","data-cursor":"link","className":"inline-flex items-center gap-1.5 text-[13px] text-muted hover:text-ink","children":[["$","span",null,{"aria-hidden":"true","children":"←"}]," All work"]}],["$","div",null,{"className":"mt-8 flex flex-wrap items-center gap-2","children":[[["$","span","Backend / Systems",{"className":"rounded-full border border-line px-2.5 py-1 text-[11.5px] text-muted","children":"Backend / Systems"}],["$","span","Client Work",{"className":"rounded-full border border-line px-2.5 py-1 text-[11.5px] text-muted","children":"Client Work"}]],["$","span",null,{"className":"rounded-full border border-signal/40 bg-signal/10 px-2.5 py-1 text-[11.5px] text-signal","children":"Completed"}]]}],["$","h1",null,{"className":"mt-5 max-w-3xl font-display text-3xl leading-tight text-ink text-balance md:text-5xl","children":"Fuel-Optimized Route Planning API"}],["$","p",null,{"className":"mt-5 max-w-2xl text-[16px] leading-relaxed text-muted","children":"A Django REST backend that plans cost-optimal fuel stops along a route using graph-based shortest-path search and spatial indexing."}],["$","div",null,{"className":"mt-8 flex flex-wrap gap-x-8 gap-y-2 text-[13.5px] text-faint","children":[["$","span",null,{"children":"Backend Developer"}],["$","span",null,{"children":"Spotter Labs — prototype"}],["$","span",null,{"children":"Feb 2026"}]]}]]}]}],["$","div",null,{"className":"mx-auto max-w-content px-6 py-16 md:px-10 md:py-20","children":["$","div",null,{"className":"grid gap-16 md:grid-cols-[1.5fr_1fr]","children":[["$","div",null,{"className":"space-y-14","children":[["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Overview"}],["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted","children":"A backend prototype for trip fuel planning: given a route and a vehicle's range and MPG, it recommends the fuel stops that minimize total trip fuel cost."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Problem"}],["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted","children":"Picking cost-efficient fuel stops along a long route isn't a simple nearest-station lookup — it has to account for the vehicle's range and MPG and the total cost across the whole trip, without exhaustively checking every station along the way."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Solution"}],["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted","children":"I modeled the route as a graph and used a Dijkstra-based shortest-path algorithm to find the minimum-cost sequence of fuel stops within the vehicle's range. Fuel-station retrieval uses H3 spatial indexing with bounding-box filtering to keep candidate lookups fast, and the API returns route polylines, per-mile fuel spend, and stop recommendations from a single call, built on a caching-ready architecture with PostgreSQL/PostGIS-ready data modeling and Redis."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"My role"}],["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted","children":"I designed and built the backend end-to-end: the Clean Architecture REST API, the Dijkstra-based optimization engine, the H3 spatial indexing layer, and the caching-ready data layer."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Engineering challenges"}],"$L3"]}],"$L4","$L5"]}],"$L6"]}]}]]}],["$L7"],"$L8"]}],"isPartial":"$@9","staleTime":"$a","vary