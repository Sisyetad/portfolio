3:["$","div",null,{"className":"mt-6 space-y-7","children":[["$","div","Modeling fuel stops as a shortest-path problem",{"className":"border-l-2 border-line pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Modeling fuel stops as a shortest-path problem"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"Minimizing total trip cost isn't the same as minimizing distance or number of stops. Representing candidate fuel stations and route segments as a graph let a standard Dijkstra search do the actual optimization, instead of hand-rolling heuristics."}]]]}],["$","div","Keeping station lookups fast along a long route",{"className":"border-l-2 border-line pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Keeping station lookups fast along a long route"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"Checking every fuel station against every route segment doesn't scale. H3 spatial indexing combined with bounding-box filtering narrows the candidate set before the optimization step ever runs, which is what keeps route computation fast."}]]]}]]}]
4:["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Technical decisions"}],["$","div",null,{"className":"mt-6 space-y-7","children":[["$","div","Clean Architecture on Django REST Framework",{"className":"border-l-2 border-signal/40 pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"Clean Architecture on Django REST Framework"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"For a backend meant to be handed off or extended, keeping the domain logic (the optimization engine) separate from the framework and infrastructure layers made the code testable independent of Django itself."}]]]}],["$","div","H3 over naive geo-radius queries",{"className":"border-l-2 border-signal/40 pl-5","children":[["$","h3",null,{"className":"text-[14.5px] font-medium text-ink","children":"H3 over naive geo-radius queries"}],[["$","p","0",{"className":"mt-2 text-[14.5px] leading-relaxed text-muted","children":"A naive radius query against every station gets slower as the station dataset grows. H3's hexagonal indexing gives constant-ish lookup behavior that scales better with data size."}]]]}]]}]]}]
5:["$","section",null,{"children":[["$","h2",null,{"className":"font-display text-xl text-ink","children":"Results"}],["$","ul",null,{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"Delivered a working single-call routing flow: route polyline, per-mile fuel spend, and fuel-stop recommendations in one response."]}],["$","li","1",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"Reduced fuel-station query complexity via H3 spatial indexing and bounding-box filtering."]}],["$","li","2",{"className":"flex gap-3 text-[14.5px] leading-relaxed text-muted","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal","aria-hidden":"true"}],"[Add measurable results if available]"]}]]}]]}]
